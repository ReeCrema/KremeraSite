{# Kremera: redesign do portal (Fable). page-head + toolbar + layout 2 colunas (.hs-layout).
   Ranking em .card-data com .rank / .vbar / top1-3; lista de skills lateral. Logica preservada.
   Skills sao 0-100 => barra proporcional; Experience (SKILL__LEVEL) mostra so o numero. #}
<div class="page-head">
	<div>
		<span class="eyebrow">Rankings</span>
		<h2>Ranking for {{ skillName }} <span>on {{ config.lua.serverName }}</span></h2>
	</div>
	<div class="meta">
		{% if skill == constant('POT::SKILL__LEVEL') %}<span class="chip chip-gold-o">Level</span>{% else %}<span class="chip chip-gold-o">Skill · 0–100</span>{% endif %}
	</div>
</div>

<div class="card">
	<div class="card-b toolbar">
		<label for="skillFilter">Choose a Skill</label>
		<select onchange="location = this.value;" id="skillFilter">
			{% for link, name in types %}
				<option value="{{ getLink('highscores') }}/{{ link|urlencode }}" {% if list is not null and list == link %}selected{% endif %}>{{ name }}</option>
			{% endfor %}
		</select>
	</div>
</div>

<table class="hs-layout"><tr>
	<td class="hs-main">
		<div class="card card-data">
			<div class="card-h"><h2>Classification</h2>{% if totalResults %}<span class="hint">{{ totalResults }} player{{ totalResults != 1 ? 's' : '' }}</span>{% endif %}</div>
			<table>
				<tr><th style="width:64px">Rank</th><th>Name</th><th class="num" style="width:190px">{{ skillName }}</th></tr>
				{% if highscores|length < 1 %}
				<tr><td colspan="3">No records yet.</td></tr>
				{% else %}
					{% for player in highscores %}
					<tr class="{% if player.rank == 1 %}top1{% elseif player.rank == 2 %}top2{% elseif player.rank == 3 %}top3{% endif %}">
						<td class="rank">{{ player.rank }}.</td>
						<td><a href="{{ player.link }}"><span {% if setting('core.highscores_online_status') %}style="color: {% if player.online > 0 %}var(--rune-glow){% else %}var(--parchment){% endif %}"{% endif %}>{{ player.name }}</span></a></td>
						<td class="num">
							{% if skill == constant('POT::SKILL__LEVEL') %}
								<span class="vnum">{{ player.value }}</span>
							{% else %}
								<span class="vbar"><i style="width:{{ player.value > 100 ? 100 : player.value }}%"></i></span><span class="vnum">{{ player.value }}</span>
							{% endif %}
						</td>
					</tr>
					{% endfor %}
				{% endif %}
			</table>
			{% if linkPreviousPage|length > 0 or linkNextPage|length > 0 %}
			<div class="pager">
				{% if linkPreviousPage|length > 0 %}<a class="btn btn-ghost btn-sm" href="{{ linkPreviousPage }}">‹ Previous Page</a>{% endif %}
				{% if linkNextPage|length > 0 %}<a class="btn btn-ghost btn-sm" href="{{ linkNextPage }}">Next Page ›</a>{% endif %}
			</div>
			{% endif %}
		</div>
	</td>
	<td class="hs-side">
		<div class="card">
			<div class="card-h"><h3>Choose a skill</h3></div>
			<div class="skill-list">
				{% for link, name in types %}
					<a href="{{ getLink('highscores') }}/{{ link|urlencode }}" {% if list == link %}class="active"{% endif %}>{{ name }}</a>
				{% endfor %}
			</div>
		</div>
	</td>
</tr></table>
